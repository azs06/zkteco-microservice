{
  "name": "zkteco-adms-worker",
  "version": "0.1.0",
  "private": true,
  "description": "ZKTeco ADMS / Security PUSH server on Cloudflare Workers, bridging devices and POS HRM installs.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zkteco_adms --local",
    "db:migrate:remote": "wrangler d1 migrations apply zkteco_adms --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
