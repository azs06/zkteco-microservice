PORT=8080
TIMEZONE=Asia/Dhaka
# Comma-separated. A device is accepted if its User-Agent contains one of these...
ALLOWED_AGENT="iClock Proxy/1.09"
# ...or its serial number is listed here (recommended for SenseFace 2A and newer firmware).
ALLOWED_SERIALS=
API_URL=https://api.example.com
API_KEY=1234567890
API_INTEGRATION_ENABLED=true

# Optional HTTPS listener (SenseFace 2A firmware connects over HTTPS only).
HTTPS_PORT=
HTTPS_KEY=./certs/server.key
HTTPS_CERT=./certs/server.crt

# Admin UI (/admin) and API (/api/admin), protected by HTTP Basic auth.
# Leave ADMIN_PASSWORD empty to disable both.
ADMIN_USER=admin
ADMIN_PASSWORD=
